apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: {{ .Package }}
  namespace: {{ .InstallNamespace }}
spec:
  channel: {{ .Channel }}
  name: {{ .Package }}
  source: {{ .Source }}
  sourceNamespace: {{ .SourceNamespace }}
  installPlanApproval: {{ .ApprovalPolicy }}
{{- if .StartingCSV }}
  startingCSV: {{ .StartingCSV }}
{{- end }}
