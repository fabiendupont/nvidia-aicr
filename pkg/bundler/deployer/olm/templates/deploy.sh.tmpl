#!/usr/bin/env bash
# Generated by AICR {{ .Version }}
# Deployer: olm
set -euo pipefail

echo "Deploying AICR recipe: {{ .RecipeName }}"
echo "Deployer: OLM (Operator Lifecycle Manager)"
echo ""
{{ range .Components }}
# --- {{ .Name }} ---
echo "Installing {{ .Name }}..."
oc apply -f {{ .Name }}/namespace.yaml 2>/dev/null || true
{{- if .HasOperatorGroup }}
oc apply -f {{ .Name }}/operatorgroup.yaml
{{- end }}
oc apply -f {{ .Name }}/subscription.yaml

echo "Waiting for {{ .Package }} CSV to succeed..."
oc wait csv -n {{ .InstallNamespace }} \
  -l operators.coreos.com/{{ .Package }}.{{ .InstallNamespace }}="" \
  --for=jsonpath='{.status.phase}'=Succeeded \
  --timeout=300s
{{ if .HasCustomResources }}
echo "Applying custom resources for {{ .Name }}..."
oc apply -f {{ .Name }}/custom-resources/
{{- end }}

echo "{{ .Name }} installed."
echo ""
{{ end }}
echo "All components deployed."
