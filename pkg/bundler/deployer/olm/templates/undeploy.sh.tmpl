#!/usr/bin/env bash
# Generated by AICR {{ .Version }}
# Deployer: olm
set -euo pipefail

echo "Removing AICR recipe: {{ .RecipeName }}"
{{ range .Components }}
# --- {{ .Name }} ---
echo "Removing {{ .Name }}..."
{{- if .HasCustomResources }}
oc delete -f {{ .Name }}/custom-resources/ --ignore-not-found
{{- end }}
oc delete -f {{ .Name }}/subscription.yaml --ignore-not-found
{{- if .HasOperatorGroup }}
oc delete -f {{ .Name }}/operatorgroup.yaml --ignore-not-found
{{- end }}
# Note: namespace {{ .InstallNamespace }} is not deleted (may contain user data)
{{ end }}
echo "All components removed."
